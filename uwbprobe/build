#!/bin/sh
# Builds uwbprobe into .build/uwbprobe/: Apple's clang compiles it for the nRF52833's Cortex-M4, and GNU ld (Homebrew's
# arm-none-eabi-binutils) links it. No SDK and no C library.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
out="$here/../.build/uwbprobe"
mkdir -p "$out"
clang --target=thumbv7em-none-eabi -mcpu=cortex-m4 -mthumb -mfloat-abi=soft \
  -ffreestanding -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables \
  -ffunction-sections -fdata-sections -Os -g -std=gnu11 -Wall -Wextra -Werror \
  -c "$here/main.c" -o "$out/main.o"
arm-none-eabi-ld -T "$here/nrf52833.ld" --gc-sections -Map "$out/uwbprobe.map" \
  -o "$out/uwbprobe.elf" "$out/main.o"
arm-none-eabi-size "$out/uwbprobe.elf"
