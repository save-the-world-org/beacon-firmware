{
  "harness": 1,
  "$comment": "The manifest (ADR 0019). Nothing else may hardcode a harness path: resolve one with node .infrared/bin/infrared-harness.mjs path <key>. A path left out is not kept in this repo. template is written by infrared-harness sync, never by hand.",
  "product": "beacon-firmware",
  "root": ".infrared",
  "delivery": {
    "mode": "trunk"
  },
  "paths": {
    "instructions": "AGENTS.md",
    "cli": ".infrared/bin/infrared-harness.mjs",
