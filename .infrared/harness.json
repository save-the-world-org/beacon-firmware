    "scripts": ".infrared/scripts",
    "claudeSettings": ".claude/settings.json",
    "claudeHooks": ".claude/hooks",
    "claudeIgnore": ".claude/.gitignore"
  },
  "verify": {
    "all": "make verify",
    "layers": [
      {
        "label": "static",
        "cmd": "make verify",
        "repair": "The harness, shellcheck, clang, swiftc and Python name the file and line; fix the first error. A failure that names sdk/ or a Qorvo file means part of Qorvo's SDK is tracked: untrack it (CLAUDE.md, Licences). A board is not in the gate: flashing and talking to one is a person's, with the board plugged in (README.md, Start here)."
      }
    ]
  },
